<script>
/* =========================================================================
   1. ROUTING — TAB BERANDA/METODE/TENTANG + HALAMAN DETAIL METODE
   -------------------------------------------------------------------------
   Struktur navigasi:
   - Tab utama (bottom nav): "home", "metode", "tentang" -> masing-masing
     menampilkan #view-home / #view-metode / #view-tentang, topbar tersembunyi.
   - Halaman detail metode (mis. #view-regresi) dibuka dari daftar di tab
     "metode", menampilkan topbar berisi tombol kembali + judul metode.

   Untuk menambah metode baru nanti:
   1. Tambahkan entri baru ke array METHODS di bawah.
   2. Jika status 'available', buat elemen <section class="view" id="view-{id}">
      berisi kalkulatornya, lalu render() akan otomatis membuatnya bisa diklik.
   3. Jika status 'soon', cukup tambahkan entrinya saja — otomatis tampil
      "Segera Hadir" dan menampilkan toast saat diketuk.
   ========================================================================= */
(function () {
  'use strict';

  const METHODS = [
    { id: 'regresi',     title: 'Regresi Linear',        subtitle: 'Sederhana & Berganda', desc: 'Hitung koefisien, susun persamaan, dan ukur seberapa kuat hubungan antar variabel.', status: 'available', tone: 'navy',
      icon: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>' },
    { id: 'smoothing',   title: 'Metode Smoothing',       subtitle: 'SMA, DMA, SES, DES & TES', desc: 'Ramalkan data deret waktu dengan Simple/Double Moving Average atau Single/Double/Triple Exponential Smoothing.', status: 'available', tone: 'teal',
      icon: '<path d="M4 19 10 9l4 5 6-10"/><circle cx="10" cy="9" r="1.4" fill="currentColor" stroke="none"/><circle cx="14" cy="14" r="1.4" fill="currentColor" stroke="none"/>' },
    { id: 'anova',       title: 'ANOVA Lengkap',          subtitle: 'Satu Arah & Dua Arah', desc: 'Bandingkan rata-rata dari lebih dari dua kelompok data sekaligus, satu faktor maupun dua faktor sekaligus (dengan interaksi).', status: 'available', tone: 'plum',
      icon: '<path d="M4 20V10M10 20V4M16 20v7M4 20h16"/>' },
    { id: 'uji-t',       title: 'Uji t',                  subtitle: 'Satu & Dua Sampel', desc: 'Bandingkan rata-rata satu kelompok terhadap nilai acuan, atau antar dua kelompok.', status: 'soon', tone: 'gold',
      icon: '<path d="M12 4v16M6 4h12M8 20h8"/>' },
    { id: 'chi-square',  title: 'Uji Chi-Square',         subtitle: null, desc: 'Uji independensi dan kesesuaian (goodness of fit) untuk data kategorik.', status: 'soon', tone: 'rust',
      icon: '<path d="M6 6h12v12H6z"/><path d="M6 12h12M12 6v12"/>' },
    { id: 'deskriptif',  title: 'Statistika Deskriptif',  subtitle: null, desc: 'Mean, median, modus, ragam, simpangan baku, dan ringkasan sebaran data.', status: 'soon', tone: 'green',
      icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  ];

  const QUOTES = [
    { q: 'Data adalah sekumpulan angka sampai seseorang memberinya makna.', a: 'Anonim' },
    { q: 'Semua model salah, tetapi beberapa di antaranya berguna.', a: 'George Box' },
    { q: 'Tanpa data, Anda hanya orang lain dengan pendapat.', a: 'W. Edwards Deming' },
    { q: 'Statistik adalah tata bahasa dari sains.', a: 'Karl Pearson' },
    { q: 'Berpikir statistik suatu hari akan sama pentingnya dengan kemampuan membaca dan menulis.', a: 'H.G. Wells' },
    { q: 'Angka tidak berbohong, tetapi cara membacanya bisa keliru.', a: 'Anonim' },
  ];

  const $ = (sel, ctx = document) => ctx.querySelector(sel);
  const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

  /* ================= AUTH (localStorage, tanpa server) ================= */
  const AUTH_KEY = 'statcalc_user';
  const STAT_KEY = 'statcalc_stats';

  // Lapisan penyimpanan aman: sebagian WebView/mode privat/pembukaan file://
  // memblokir localStorage dan melempar SecurityError. Tanpa penanganan ini,
  // seluruh skrip berhenti total. Di sini kita jatuh ke penyimpanan memori
  // (bertahan selama tab terbuka) bila localStorage tidak tersedia.
  const memoryFallback = {};
  let storageBlocked = false;
  const safeStorage = {
    getItem(k) {
      try { return localStorage.getItem(k); }
      catch (e) { storageBlocked = true; return Object.prototype.hasOwnProperty.call(memoryFallback, k) ? memoryFallback[k] : null; }
    },
    setItem(k, v) {
      try { localStorage.setItem(k, v); }
      catch (e) { storageBlocked = true; memoryFallback[k] = String(v); }
    },
    removeItem(k) {
      try { localStorage.removeItem(k); }
      catch (e) { storageBlocked = true; delete memoryFallback[k]; }
    },
  };

  function getUser() { return safeStorage.getItem(AUTH_KEY); }
  function setUser(name) { safeStorage.setItem(AUTH_KEY, name); }
  function clearUser() { safeStorage.removeItem(AUTH_KEY); }

  function getStats() {
    try { return JSON.parse(safeStorage.getItem(STAT_KEY) || '{"usedMethods":[],"calcCount":0,"since":null}'); }
    catch (e) { return { usedMethods: [], calcCount: 0, since: null }; }
  }
  function saveStats(s) { safeStorage.setItem(STAT_KEY, JSON.stringify(s)); }
  function trackMethodUse(id) {
    const s = getStats();
    if (!s.usedMethods.includes(id)) s.usedMethods.push(id);
    saveStats(s);
  }
  function trackCalc() {
    const s = getStats();
    s.calcCount = (s.calcCount || 0) + 1;
    saveStats(s);
    refreshProfileStats();
  }

  const loginError = $('#loginError');
  const inputNama = $('#inputNama');
  const btnMasuk = $('#btnMasuk');

  function doLogin() {
    const name = inputNama.value.trim();
    if (!name) {
      loginError.textContent = 'Nama tidak boleh kosong.';
      loginError.classList.add('show');
      return;
    }
    loginError.classList.remove('show');
    setUser(name);
    const s = getStats();
    if (!s.since) { s.since = new Date().toISOString(); saveStats(s); }
    applyUserToUI();
    document.body.classList.remove('pre-auth');
    switchTab('home');
  }
  btnMasuk.addEventListener('click', doLogin);
  inputNama.addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); });

  function initials(name) {
    const parts = name.trim().split(/\s+/);
    return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase() || '?';
  }

  function applyUserToUI() {
    const name = getUser();
    if (!name) return;
    $('#skyAvatar').textContent = initials(name);
    $('#profileAvatarBig').textContent = initials(name);
    $('#skyGreetName').textContent = name;
    $('#profileName').textContent = name;
    const s = getStats();
    if (s.since) {
      const d = new Date(s.since);
      $('#profileSince').textContent = 'Bergabung ' + d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    }
    const hour = new Date().getHours();
    $('#skyGreetHi').textContent = hour < 11 ? 'Selamat pagi' : hour < 15 ? 'Selamat siang' : hour < 19 ? 'Selamat sore' : 'Selamat malam';
    refreshProfileStats();
  }

  function refreshProfileStats() {
    const s = getStats();
    $('#profileStatUsed').textContent = s.usedMethods.length;
    $('#profileStatCalc').textContent = s.calcCount || 0;
  }

  /* ================= QUOTE ================= */
  function setRandomQuote() {
    const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    $('#quoteText').textContent = `\u201C${q.q}\u201D`;
    $('#quoteAuthor').textContent = `\u2014 ${q.a}`;
  }

  /* ================= RENDER MENU KARTU ================= */
  const tocList = $('#tocList');
  const tocCount = $('#tocCount');
  const hubGrid = $('#hubGrid');
  const topbar = $('#topbar');
  const backBtn = $('#backBtn');
  const pageTitle = $('#pageTitle');
  const bottomNav = $('#bottomNav');
  const toast = $('#toast');

  // Tab utama yang punya tombol di bottom nav ("home"). Halaman lain
  // (metode, kuis, kalkulator, petunjuk, tentang, & detail metode) diakses
  // dari kartu-kartu di Beranda / panel Profil, dan selalu punya topbar
  // dengan tombol kembali ke `backTarget`.
  const TABS = {
    home: 'view-home', metode: 'view-metode', tentang: 'view-tentang',
    kuis: 'view-kuis', kalkulator: 'view-kalkulator', petunjuk: 'view-petunjuk',
  };
  const PAGE_TITLES = {
    metode: 'Pilih Metode', tentang: 'Tentang StatCalc',
    kuis: 'Kuis Statistika', kalkulator: 'Kalkulator Ilmiah', petunjuk: 'Petunjuk',
  };
  let backTarget = 'home';

  const available = METHODS.filter((c) => c.status === 'available').length;
  tocCount.textContent = `${available} tersedia \u00B7 ${METHODS.length - available} segera hadir`;

  function cardHTML(c) {
    const isAvailable = c.status === 'available';
    return `
      <button type="button" class="menu-card ${isAvailable ? '' : 'is-soon'}" data-method="${c.id}" data-available="${isAvailable}">
        <div class="mc-top">
          <span class="mc-icon tone-${c.tone}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${c.icon}</svg></span>
          ${isAvailable ? '<span class="mc-chevron" aria-hidden="true">&rsaquo;</span>' : ''}
        </div>
        <div>
          <div class="mc-title">${c.title}</div>
          ${c.subtitle ? `<div class="mc-sub">${c.subtitle}</div>` : ''}
        </div>
        <p class="mc-desc">${c.desc}</p>
        <span class="mc-status ${isAvailable ? 'available' : 'soon'}">${isAvailable ? 'Tersedia' : 'Segera Hadir'}</span>
      </button>`;
  }

  tocList.innerHTML = METHODS.map(cardHTML).join('');

  function handleMenuClick(e) {
    const card = e.target.closest('.menu-card');
    if (!card) return;
    const id = card.dataset.method;
    const isAvailable = card.dataset.available === 'true';
    const method = METHODS.find((c) => c.id === id);
    if (isAvailable) {
      trackMethodUse(id);
      goToMethod(id, method.title);
    } else {
      showToast(`Metode \u201C${method.title}\u201D sedang disiapkan \u2014 nantikan pembaruan berikutnya.`);
    }
  }
  tocList.addEventListener('click', handleMenuClick);

  /* ---- Kartu hub di Beranda (Pilih Metode / Kuis / Kalkulator / Petunjuk) ---- */
  hubGrid.addEventListener('click', (e) => {
    const card = e.target.closest('.hub-card');
    if (!card) return;
    const target = card.dataset.nav;
    navigate(target, { backTo: 'home' });
    if (target === 'kuis' && window.StatCalcQuiz) window.StatCalcQuiz.resetToIntro();
    if (target === 'kalkulator' && window.StatCalcCalc) window.StatCalcCalc.reset();
  });

  /* ---- Navigasi umum: tab utama (home) & halaman turunan lainnya ---- */
  function navigate(pageId, opts = {}) {
    if (!TABS[pageId]) return;
    $$('.view').forEach((v) => v.classList.remove('active'));
    $('#' + TABS[pageId]).classList.add('active');
    $$('.nav-item', bottomNav).forEach((b) => b.classList.toggle('active', b.dataset.tab === 'home' && pageId === 'home'));
    if (pageId === 'home') {
      topbar.classList.remove('visible');
      setRandomQuote(); updateSky();
    } else {
      topbar.classList.add('visible');
      pageTitle.textContent = opts.title || PAGE_TITLES[pageId] || '';
      backTarget = opts.backTo || 'home';
    }
    window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
  }
  // Alias lama, dipakai beberapa tempat & tersedia untuk metode lain nanti.
  function switchTab(tabId) { navigate(tabId); }

  $$('.nav-item', bottomNav).forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.tab === 'profil') { openProfile(); return; }
      navigate(btn.dataset.tab);
    });
  });

  /* ---- Navigasi ke halaman detail metode (mis. Regresi Linear) ---- */
  function goToMethod(id, title) {
    const target = $('#view-' + id);
    if (!target) {
      showToast('Metode ini belum tersedia.');
      return;
    }
    $$('.view').forEach((v) => v.classList.remove('active'));
    target.classList.add('active');
    topbar.classList.add('visible');
    pageTitle.textContent = title || '';
    backTarget = 'metode';
    $$('.nav-item', bottomNav).forEach((b) => b.classList.remove('active'));
    window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
  }

  backBtn.addEventListener('click', () => navigate(backTarget));

  let toastTimer = null;
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
  }

  /* ================= PANEL PROFIL ================= */
  const profilePanel = $('#profilePanel');
  const profileOverlay = $('#profileOverlay');
  const navProfilBtn = $('#navProfilBtn');
  function openProfile() { profilePanel.classList.add('open'); profileOverlay.classList.add('show'); if (navProfilBtn) navProfilBtn.classList.add('active'); }
  function closeProfile() { profilePanel.classList.remove('open'); profileOverlay.classList.remove('show'); if (navProfilBtn) navProfilBtn.classList.remove('active'); }
  $('#openProfileBtn').addEventListener('click', openProfile);
  $('#closeProfileBtn').addEventListener('click', closeProfile);
  profileOverlay.addEventListener('click', closeProfile);
  $('#btnKeTentang').addEventListener('click', () => { closeProfile(); navigate('tentang', { backTo: 'home' }); });
  $('#btnGantiNama').addEventListener('click', () => {
    const current = getUser() || '';
    const next = window.prompt('Nama baru:', current);
    if (next && next.trim()) { setUser(next.trim()); applyUserToUI(); showToast('Nama berhasil diperbarui.'); }
  });
  $('#btnKeluar').addEventListener('click', () => {
    closeProfile();
    clearUser();
    inputNama.value = '';
    $$('.view').forEach((v) => v.classList.remove('active'));
    $('#view-login').classList.add('active');
    topbar.classList.remove('visible');
    document.body.classList.add('pre-auth');
  });

  /* ================= INISIALISASI ================= */
  const existingUser = getUser();
  if (existingUser) {
    applyUserToUI();
    document.body.classList.remove('pre-auth');
    $$('.view').forEach((v) => v.classList.remove('active'));
    $('#view-home').classList.add('active');
    $$('.nav-item', bottomNav).forEach((b) => b.classList.toggle('active', b.dataset.tab === 'home'));
    setRandomQuote();
  } else {
    document.body.classList.add('pre-auth');
    setRandomQuote();
  }

  // expose minimal API untuk metode lain nanti
  window.StatCalc = { switchTab, navigate, goToMethod, showToast, trackCalc };
})();

/* =========================================================================
   1.5 HEADER LANGIT — ANIMASI SIANG/MALAM REAL-TIME
   -------------------------------------------------------------------------
   Warna langit, posisi matahari/bulan, awan dan bintang mengikuti jam
   perangkat pengguna saat ini (0-23). Dipanggil ulang tiap kali tab
   "Beranda" dibuka, lalu berjalan sendiri via requestAnimationFrame.
   ========================================================================= */
(function () {
  'use strict';

  const SKY_COLORS_24 = [
    ['#0B1424', '#16263A', '#22384A'], // 00
    ['#0A1220', '#141F34', '#1C2E3E'], // 01
    ['#09101C', '#111B2E', '#182636'], // 02
    ['#0B1424', '#152540', '#1E344A'], // 03
    ['#0C1830', '#1B2E52', '#2A4468'], // 04
    ['#1A2050', '#6E3A1E', '#B0631F'], // 05 subuh
    ['#22384A', '#B0631F', '#D98A2B'], // 06 fajar
    ['#22384A', '#3E6688', '#E0A040'], // 07
    ['#22384A', '#4A7DA0', '#8FC1DE'], // 08
    ['#22384A', '#4A85AC', '#9ED0E8'], // 09
    ['#2E4A61', '#4E8CB4', '#A6D6EC'], // 10
    ['#2E4A61', '#5090B6', '#AEDBEE'], // 11
    ['#3661A0', '#4E8CB4', '#A6D6EC'], // 12 terik
    ['#2E4A61', '#4E8CB4', '#A6D6EC'], // 13
    ['#2E4A61', '#4A85AC', '#9ED0E8'], // 14
    ['#284870', '#3E6688', '#D98A46'], // 15
    ['#22384A', '#8A4B24', '#D98A2B'], // 16
    ['#1E3050', '#8A3E1E', '#C25A1E'], // 17
    ['#301A48', '#7A2E5C', '#B0481E'], // 18 magrib
    ['#1A1030', '#301E5C', '#5C2848'], // 19
    ['#0F1430', '#161F44', '#22384A'], // 20
    ['#0B1424', '#131F38', '#1A2C42'], // 21
    ['#09101C', '#111B2E', '#182636'], // 22
    ['#0B1424', '#16263A', '#22384A'], // 23
  ];

  const STARS = [];
  for (let i = 0; i < 18; i++) {
    STARS.push({ x: Math.random() * 94 + 1, y: Math.random() * 70 + 2, r: Math.random() * 1.4 + 0.6, phase: Math.random() * Math.PI * 2 });
  }

  let built = false, raf = null, prevHour = -1;

  function hexToRgb(hex) { return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)]; }
  function rgbToHex(r, g, b) { return '#' + [r, g, b].map((v) => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, '0')).join(''); }
  function lerpColor(c1, c2, t) { const a = hexToRgb(c1), b = hexToRgb(c2); return rgbToHex(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t); }

  function build() {
    if (built) return;
    const banner = document.getElementById('skyBanner');
    if (!banner) return;
    built = true;
    const cloudSpots = [[6, 12, 22], [24, 8, 18], [50, 14, 24], [70, 6, 20], [86, 16, 16]];
    document.getElementById('skyClouds').innerHTML = cloudSpots.map(([x, y, sz], i) =>
      `<div style="position:absolute;left:${x}%;top:${y}%;font-size:${sz}px;opacity:.55;animation:skyDrift ${9 + i * 2}s ease-in-out infinite ${i * .7}s;">\u2601\uFE0F</div>`
    ).join('');
  }

  function loop(ts) {
    const now = new Date();
    const h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
    const totalMin = h * 60 + m + s / 60;

    const clock = document.getElementById('skyClock');
    if (clock) clock.textContent = String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');

    // bintang berkelap-kelip
    const cv = document.getElementById('skyStars');
    const starAlpha = h < 5 ? 1 : h < 6 ? .4 : h >= 21 ? 1 : h >= 19 ? .6 : h >= 18 ? .25 : 0;
    if (cv) {
      const W = cv.clientWidth, H = cv.clientHeight;
      if (cv.width !== W) cv.width = W;
      if (cv.height !== H) cv.height = H;
      const ctx = cv.getContext && cv.getContext('2d');
      if (ctx) {
        ctx.clearRect(0, 0, W, H);
        if (starAlpha > 0) {
          STARS.forEach((st) => {
            const tw = 0.55 + 0.45 * Math.sin(ts / 1100 + st.phase);
            ctx.globalAlpha = starAlpha * tw * 0.9;
            ctx.fillStyle = '#fff';
            ctx.beginPath();
            ctx.arc(st.x / 100 * W, st.y / 100 * H, st.r, 0, Math.PI * 2);
            ctx.fill();
          });
          ctx.globalAlpha = 1;
        }
      }
    }

    // orbit matahari/bulan
    const isSun = h >= 6 && h < 18;
    let frac = isSun ? (totalMin - 360) / 720 : ((totalMin >= 1080 ? totalMin - 1080 : totalMin + 360) / 720);
    frac = Math.max(0, Math.min(1, frac));
    const angle = (180 - frac * 180) * Math.PI / 180;
    const R = 120;
    const bx = 130 + R * Math.cos(angle);
    const by = 130 - R * Math.sin(angle) * 0.86;
    const body = document.getElementById('skyBody');
    if (body) {
      body.style.transform = `translate(${bx - 17}px, ${by - 17}px)`;
      if (h >= 6 && h < 7) { body.textContent = '\uD83C\uDF05'; body.style.fontSize = '22px'; }
      else if (h >= 7 && h < 17) { body.textContent = '\u2600\uFE0F'; body.style.fontSize = (h >= 11 && h < 15) ? '28px' : '25px'; body.style.filter = 'drop-shadow(0 0 10px rgba(255,220,120,.85))'; }
      else if (h >= 17 && h < 19) { body.textContent = '\uD83C\uDF07'; body.style.fontSize = '22px'; }
      else { body.textContent = '\uD83C\uDF19'; body.style.fontSize = '24px'; body.style.filter = 'drop-shadow(0 0 8px rgba(210,225,255,.65))'; }
    }

    if (h !== prevHour) { prevHour = h; applyPhase(h); }
    raf = requestAnimationFrame(loop);
  }

  function applyPhase(h) {
    const bg = document.getElementById('skyBg');
    const clouds = document.getElementById('skyClouds');
    const extras = document.getElementById('skyExtras');
    if (!bg) return;
    const m = new Date().getMinutes();
    const t = m / 60;
    const next = (h + 1) % 24;
    const c1 = SKY_COLORS_24[h], c2 = SKY_COLORS_24[next];
    const top = lerpColor(c1[0], c2[0], t), mid = lerpColor(c1[1], c2[1], t), bot = lerpColor(c1[2], c2[2], t);
    bg.style.background = `linear-gradient(160deg, ${top}, ${mid}, ${bot})`;
    if (clouds) clouds.style.opacity = h < 5 ? 0 : h < 7 ? .5 : h < 17 ? .7 : h < 19 ? .4 : h < 21 ? .15 : 0;
    const EXTRAS = {
      5: '<div style="position:absolute;right:8%;top:16%;font-size:12px;opacity:.4;animation:skyFloat 3s ease-in-out infinite;">\u2728</div>',
      12: '<div style="position:absolute;left:6%;top:14%;font-size:11px;opacity:.4;animation:skyFloat 2.4s ease-in-out infinite;">\u2728</div>',
      19: '<div style="position:absolute;left:10%;top:12%;font-size:10px;opacity:.35;animation:skyFloat 3.2s ease-in-out infinite;">\u2B50</div>',
      21: '<div style="position:absolute;right:12%;top:16%;font-size:10px;opacity:.4;animation:skyFloat 3.6s ease-in-out infinite;">\u2B50</div><div style="position:absolute;left:20%;top:24%;font-size:9px;opacity:.3;animation:skyFloat 2.8s ease-in-out infinite .6s;">\u2B50</div>',
    };
    if (extras) extras.innerHTML = EXTRAS[h] || '';
  }

  function updateSky() {
    build();
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(loop);
  }

  window.updateSky = updateSky;
  try {
    if (localStorage.getItem('statcalc_user')) updateSky();
  } catch (e) { /* localStorage diblokir; updateSky akan dipanggil oleh switchTab saat login berhasil */ }
})();
</script>

