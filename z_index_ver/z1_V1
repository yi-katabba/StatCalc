<!DOCTYPE html> 
<html lang="id"> 
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>StatCalc — APLIKASI Kerja Statistik</title>
<meta name="theme-color" content="#22384A">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
<meta name="color-scheme" content="light">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* =========================================================================
   STATCALC — single-file webview app
   Tema visual: "Aplikasi kerja statistik" — kertas krem, kartu metode dengan
   nomor urut, daftar metode dengan garis titik-titik seperti buku cetak.
   ========================================================================= */

/* ---------- TOKENS ---------- */
:root{
  --paper:      #FBF9F2;
  --paper-2:    #F2EDDF;
  --ink:        #1C1E24;
  --ink-soft:   #52565F;
  --ink-faint:  #948C77;
  --rule:       #DAD2B8;
  --rule-strong:#AEA484;
  --accent:     #22384A;
  --accent-hi:  #2E4A61;
  --accent-press:#1A2C3A;
  --accent-2:   #BD7E1F;
  --accent-soft:#E3ECF0;
  --good:       #2F6B45;
  --bad:        #A5402C;
  --bad-bg:     #F7E7E1;

  --font-display: 'Lora', Georgia, serif;
  --font-body:    'Inter', system-ui, sans-serif;
  --font-mono:    'IBM Plex Mono', 'Courier New', monospace;

  --radius: 6px;
  --shadow: 0 1px 0 rgba(28,30,36,0.05), 0 6px 16px -10px rgba(28,30,36,0.28);
  --shadow-bar: 0 2px 10px -4px rgba(28,30,36,0.35);

  --tap: 44px; /* target sentuh minimum untuk aplikasi mobile */
  --navh: 60px; /* tinggi menu navigasi bawah */
  --safe-t: env(safe-area-inset-top, 0px);
  --safe-b: env(safe-area-inset-bottom, 0px);
  --safe-l: env(safe-area-inset-left, 0px);
  --safe-r: env(safe-area-inset-right, 0px);
}

*{ box-sizing:border-box; }
html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
  text-size-adjust:100%;
  overscroll-behavior-y:none;
}
html, body{ height:100%; }
body{
  margin:0;
  font-family:var(--font-body);
  color:var(--ink);
  background:var(--paper);
  line-height:1.55;
  position:relative;
  min-height:100vh;
  overscroll-behavior-y:none;
  -webkit-tap-highlight-color:transparent;
  -webkit-touch-callout:none;
}
/* --- Mode aplikasi mobile / WebView: target sentuh, tanpa efek hover aneh --- */
button, a, [role="button"], .toc-row, input, select, textarea{
  -webkit-tap-highlight-color:transparent;
  touch-action:manipulation;
}
input, select, textarea{ font-size:16px; } /* mencegah auto-zoom di dalam WebView */
img, svg{ -webkit-user-drag:none; user-select:none; }
.sheet-bg{
  position:fixed; inset:0; z-index:-1; pointer-events:none;
  background-image:repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgba(34,56,74,0.05) 36px);
  background-position:0 96px;
}
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior:auto; }
  *{ animation-duration:0.01ms !important; transition-duration:0.01ms !important; }
}
button{ font-family:var(--font-body); }
button:focus-visible, input:focus-visible, [tabindex]:focus-visible{
  outline:2px solid var(--accent-2);
  outline-offset:2px;
}

/* ---------- TOP APP BAR (hanya tampil di halaman detail metode) ---------- */
.topbar{
  display:none;
  position:sticky; top:0; z-index:20;
  align-items:center; gap:12px;
  padding:calc(14px + var(--safe-t)) calc(18px + var(--safe-r)) 14px calc(18px + var(--safe-l));
  min-height:calc(56px + var(--safe-t));
  background:var(--accent);
  box-shadow:var(--shadow-bar);
}
.topbar.visible{ display:flex; }
.back-btn{
  display:inline-flex; align-items:center; justify-content:center; gap:5px;
  background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.28);
  color:#fff;
  font-weight:600; font-size:13.5px;
  min-height:var(--tap); flex-shrink:0;
  padding:0 14px 0 10px; border-radius:100px;
  cursor:pointer;
  transition:background .12s ease, transform .08s ease;
}
.back-btn::before{ content:'\2039'; font-family:var(--font-display); font-size:20px; line-height:1; margin-right:-2px; }
.back-btn:hover{ background:rgba(255,255,255,0.16); }
.back-btn:active{ background:rgba(255,255,255,0.24); transform:scale(.97); }
.topbar .page-title{
  font-family:var(--font-display); font-weight:700; font-size:16.5px;
  color:#fff;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}

/* ---------- VIEW SWITCHING ---------- */
.view{ display:none; }
.view.active{ display:block; animation:fadeIn .25s ease; }
@keyframes fadeIn{ from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:translateY(0);} }

/* ---------- HOME / COVER ---------- */
.cover{
  padding:calc(36px + var(--safe-t)) 24px 20px;
  max-width:760px; margin:0 auto;
}
.eyebrow{
  display:inline-block;
  font-family:var(--font-mono); font-size:12px; letter-spacing:.12em; text-transform:uppercase;
  color:var(--accent); border:1px solid var(--accent);
  padding:3px 9px; border-radius:100px; margin-bottom:18px;
}
.cover h1{
  font-family:var(--font-display); font-weight:700;
  font-size:clamp(34px,6vw,52px); line-height:1.08; margin:0 0 12px;
}
.cover .lede{ font-size:16.5px; color:var(--ink-soft); max-width:56ch; margin:0; text-align:justify; text-justify:inter-word; }

.toc-section{
  max-width:760px; margin:0 auto; padding:8px 24px 8px;
}
.toc-heading{
  display:flex; align-items:baseline; justify-content:space-between;
  border-bottom:2px solid var(--ink); padding-bottom:8px; margin-bottom:6px;
}
.toc-heading h2{
  font-family:var(--font-display); font-size:20px; margin:0; font-weight:600;
}
.toc-heading .count{
  font-family:var(--font-mono); font-size:12.5px; color:var(--ink-faint);
}

.toc-list{ list-style:none; margin:0; padding:0; }

.toc-row{
  display:block;
  width:100%;
  text-align:left;
  background:none;
  border:none;
  border-bottom:1px solid var(--rule);
  padding:18px 10px;
  border-radius:var(--radius);
  cursor:pointer;
  color:inherit;
  transition:background .12s ease;
}
.toc-row:last-child{ border-bottom:none; }
.toc-row.is-soon{ cursor:default; }
.toc-row:hover:not(.is-soon){ background:var(--paper-2); }
.toc-row:active:not(.is-soon){ background:var(--accent-soft); }

.toc-row-top{
  display:flex; align-items:center; gap:14px;
}
.toc-num{
  font-family:var(--font-display); font-weight:700; font-size:26px;
  color:var(--rule-strong);
  width:46px; flex-shrink:0;
}
.toc-row:not(.is-soon) .toc-num{ color:var(--accent); }

.toc-title-wrap{ flex:1; min-width:0; }
.toc-title{
  font-size:16.5px; font-weight:700; color:var(--ink);
  display:flex; align-items:baseline; gap:6px; flex-wrap:wrap;
}
.toc-subtitle{
  font-family:var(--font-mono); font-size:12.5px; color:var(--ink-faint); font-weight:400;
}
.toc-leader{
  flex:1; min-width:20px;
  border-bottom:1.5px dotted var(--rule-strong);
  margin:0 2px; transform:translateY(-5px);
}
.toc-status{
  font-family:var(--font-mono); font-size:11.5px; font-weight:600;
  letter-spacing:.04em; padding:3px 9px; border-radius:100px;
  white-space:nowrap; flex-shrink:0;
}
.toc-status.available{ background:var(--accent-soft); color:var(--accent); }
.toc-status.soon{ background:var(--paper-2); color:var(--ink-faint); border:1px solid var(--rule); }
.toc-chevron{
  font-family:var(--font-display); font-size:22px; line-height:1;
  color:var(--rule-strong); flex-shrink:0;
}

.toc-desc{
  margin:6px 0 0 60px;
  font-size:13.5px; color:var(--ink-soft);
  max-width:56ch;
}
.toc-row.is-soon .toc-title, .toc-row.is-soon .toc-desc{ color:var(--ink-faint); }

.cover-footer{
  max-width:760px; margin:0 auto; padding:0 24px calc(50px + var(--navh) + var(--safe-b));
  font-size:13px; color:var(--ink-faint); text-align:center;
}

/* ---------- TOAST ---------- */
.toast{
  position:fixed; left:50%; bottom:calc(var(--navh) + var(--safe-b) + 16px); transform:translateX(-50%) translateY(20px);
  background:var(--ink); color:var(--paper);
  padding:12px 20px; border-radius:100px;
  font-size:13.5px; font-weight:500;
  max-width:calc(100vw - 48px); text-align:center;
  box-shadow:0 10px 30px -8px rgba(0,0,0,0.4);
  z-index:50; opacity:0; pointer-events:none;
  transition:opacity .25s ease, transform .25s ease;
}
.toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

/* ---------- CHAPTER LAYOUT (shared) ---------- */
.chapter-inner{
  max-width:920px; margin:0 auto; padding:20px 24px calc(60px + var(--navh) + var(--safe-b));
  display:flex; flex-direction:column; gap:28px;
}
.chapter-head{ max-width:760px; }
.chapter-head .eyebrow{ margin-bottom:14px; }
.chapter-head h1{
  font-family:var(--font-display); font-weight:700;
  font-size:clamp(28px,4.5vw,40px); line-height:1.12; margin:0 0 10px;
}
.chapter-head .lede{ font-size:16px; color:var(--ink-soft); max-width:60ch; margin:0; text-align:justify; text-justify:inter-word; }

/* ---------- CARDS (regresi chapter reuses this) ---------- */
.card{
  background:#fff; border:1px solid var(--rule); border-radius:var(--radius);
  box-shadow:var(--shadow); padding:28px 28px 30px; position:relative;
}
.step-tag{
  font-family:var(--font-mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--accent-2); font-weight:600; margin-bottom:6px;
}
.card h2{ font-family:var(--font-display); font-size:24px; font-weight:600; margin:0 0 8px; }
.hint{ color:var(--ink-soft); font-size:14.5px; margin:0 0 20px; text-align:justify; text-justify:inter-word; }

.control-row{ display:flex; flex-wrap:wrap; align-items:center; gap:14px; margin-top:6px; }
.control-row[hidden]{ display:none; }
label{ font-size:14px; font-weight:600; color:var(--ink); }

.stepper{ display:inline-flex; align-items:stretch; border:1px solid var(--rule-strong); border-radius:var(--radius); overflow:hidden; height:var(--tap); }
.stepper button{ width:44px; border:none; background:var(--paper-2); color:var(--accent); font-size:19px; font-family:var(--font-mono); cursor:pointer; transition:background .12s ease; }
.stepper button:hover{ background:var(--accent-soft); }
.stepper button:active{ background:var(--accent-soft); }
.stepper input{ width:56px; border:none; border-left:1px solid var(--rule-strong); border-right:1px solid var(--rule-strong); text-align:center; font-family:var(--font-mono); font-size:16px; padding:8px 4px; -moz-appearance:textfield; }
.stepper input::-webkit-outer-spin-button, .stepper input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }

.select-input{
  height:var(--tap); min-width:260px; border:1px solid var(--rule-strong); border-radius:var(--radius);
  background:#fff; color:var(--ink); font-family:var(--font-body); font-size:14.5px; font-weight:600;
  padding:0 12px; cursor:pointer;
}
.select-input:focus{ outline:2px solid var(--accent-2); outline-offset:1px; }
.plain-input{
  height:var(--tap); width:140px; border:1px solid var(--rule-strong); border-radius:var(--radius);
  background:#fff; color:var(--ink); font-family:var(--font-mono); font-size:16px; text-align:center;
  padding:0 10px; -moz-appearance:textfield;
}
.plain-input::-webkit-outer-spin-button, .plain-input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
.plain-input:focus{ outline:2px solid var(--accent-2); outline-offset:1px; }
.field-note{ flex-basis:100%; color:var(--ink-faint); font-size:12.5px; margin:2px 0 0; }

.btn-primary{
  background:var(--accent); color:#fff; border:1px solid var(--accent);
  min-height:var(--tap);
  padding:10px 22px; border-radius:var(--radius); font-weight:600; font-size:14.5px;
  cursor:pointer; transition:background .12s ease, transform .08s ease;
}
.btn-primary:hover{ background:var(--accent-hi); }
.btn-primary:active{ background:var(--accent-press); transform:scale(.98); }
.btn-ghost{
  background:#fff; color:var(--accent); border:1px solid var(--rule-strong);
  min-height:var(--tap);
  padding:9px 18px; border-radius:var(--radius); font-weight:600; font-size:14px;
  cursor:pointer; transition:background .12s ease, border-color .12s ease, transform .08s ease;
}
.btn-ghost:hover{ background:var(--accent-soft); border-color:var(--accent); }
.btn-ghost:active{ background:var(--accent-soft); border-color:var(--accent); transform:scale(.98); }

.error-msg{
  margin-top:16px; background:var(--bad-bg); color:var(--bad);
  border:1px solid #E0B8AC; border-radius:var(--radius); padding:10px 14px;
  font-size:14px; font-weight:500;
}

.table-scroll{ overflow-x:auto; border:1px solid var(--rule); border-radius:var(--radius); }
table.data-table{ border-collapse:collapse; width:100%; min-width:420px; font-family:var(--font-mono); font-size:14px; }
table.data-table thead th{ background:var(--paper-2); color:var(--ink); text-align:center; padding:10px 8px; border-bottom:2px solid var(--rule-strong); font-weight:600; white-space:nowrap; }
table.data-table tbody td{ border-bottom:1px solid var(--rule); padding:0; text-align:center; }
table.data-table tbody tr:last-child td{ border-bottom:none; }
table.data-table tbody td.rownum{ color:var(--ink-soft); font-size:12.5px; background:var(--paper-2); width:36px; }
table.data-table input[type="text"]{ width:100%; min-height:var(--tap); border:none; background:transparent; padding:9px 10px; text-align:center; font-family:var(--font-mono); font-size:15px; color:var(--ink); }
table.data-table input:focus{ outline:none; background:var(--accent-soft); }
table.data-table input.invalid{ background:var(--bad-bg); color:var(--bad); }

.tabs{
  display:flex; flex-wrap:nowrap; gap:4px; border-bottom:1px solid var(--rule); margin-bottom:22px;
  overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none;
}
.tabs::-webkit-scrollbar{ display:none; }
.tab-btn{ background:none; border:none; border-bottom:2px solid transparent; padding:10px 4px; margin-right:18px; font-size:14.5px; font-weight:600; color:var(--ink-soft); cursor:pointer; white-space:nowrap; min-height:var(--tap); flex-shrink:0; }
.tab-btn:hover{ color:var(--ink); }
.tab-btn.active{ color:var(--accent); border-bottom-color:var(--accent-2); }
.tab-panel{ display:none; }
.tab-panel.active{ display:block; }

table.result-table{ border-collapse:collapse; width:100%; font-family:var(--font-mono); font-size:13.5px; }
table.result-table caption{ caption-side:top; text-align:left; font-family:var(--font-body); font-weight:600; font-size:14px; padding-bottom:8px; color:var(--ink); }
table.result-table th, table.result-table td{ border:1px solid var(--rule); padding:8px 10px; text-align:right; white-space:nowrap; }
table.result-table thead th{ background:var(--paper-2); text-align:center; color:var(--ink); }
table.result-table tbody td:first-child, table.result-table tbody th{ text-align:center; background:var(--paper-2); font-weight:600; }
table.result-table tfoot td{ background:var(--accent-soft); font-weight:700; color:var(--accent); }

.steps-wrap{ display:flex; flex-direction:column; gap:18px; }
.step-block{ position:relative; padding:14px 18px 16px 52px; background:var(--paper-2); border:1px solid var(--rule); border-radius:var(--radius); }
.step-block::before{ content:attr(data-step); position:absolute; left:14px; top:14px; width:26px; height:26px; border-radius:50%; background:var(--accent); color:#fff; font-family:var(--font-mono); font-size:12.5px; font-weight:700; display:flex; align-items:center; justify-content:center; }
.step-block h4{ margin:0 0 6px; font-size:15px; font-family:var(--font-body); color:var(--ink); }
.step-block .formula{ display:block; font-family:var(--font-mono); font-size:14px; background:#fff; border:1px dashed var(--rule-strong); border-radius:var(--radius); padding:8px 12px; margin:6px 0; overflow-x:auto; color:var(--accent); }
.step-block p{ margin:6px 0 0; font-size:14px; color:var(--ink-soft); }
.step-block .matrix{ font-family:var(--font-mono); font-size:13px; white-space:pre; background:#fff; border:1px dashed var(--rule-strong); border-radius:var(--radius); padding:10px 12px; overflow-x:auto; margin:6px 0; }

.equation-wrap{ display:flex; flex-direction:column; gap:22px; }
.equation-box{ background:var(--accent); color:#fff; border-radius:var(--radius); padding:22px 24px; text-align:center; }
.equation-box .label{ font-family:var(--font-mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase; opacity:.75; margin-bottom:8px; }
.equation-box .eq{ font-family:var(--font-mono); font-size:clamp(18px,3vw,24px); font-weight:600; word-break:break-word; }

.stat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; }
.stat-card{ border:1px solid var(--rule); border-radius:var(--radius); padding:14px 16px; background:var(--paper-2); }
.stat-card .k{ font-family:var(--font-mono); font-size:12px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.06em; }
.stat-card .v{ font-family:var(--font-mono); font-size:20px; font-weight:700; color:var(--accent); margin-top:4px; }

.interpretation{ border-left:3px solid var(--accent-2); padding:4px 4px 4px 16px; font-size:14.5px; color:var(--ink); }
.interpretation p{ margin:0 0 10px; text-align:justify; text-justify:inter-word; hyphens:auto; }
.interpretation p:last-child{ margin-bottom:0; }
.interpretation strong{ color:var(--accent); }

.test-block{ border:1px solid var(--rule); border-radius:var(--radius); padding:18px 20px 20px; margin-bottom:18px; background:#fff; }
.test-block:last-child{ margin-bottom:0; }
.test-block h4{ font-family:var(--font-display); font-size:16.5px; font-weight:600; margin:0 0 4px; color:var(--ink); }
.test-block .test-sub{ font-size:12.5px; color:var(--ink-faint); margin:0 0 14px; }
.hyp-box{ background:var(--paper-2); border-radius:var(--radius); padding:12px 14px; margin-bottom:14px; font-size:13.5px; line-height:1.6; }
.hyp-box .hyp-row{ display:flex; gap:8px; }
.hyp-box .hyp-row + .hyp-row{ margin-top:4px; }
.hyp-box .hyp-tag{ font-family:var(--font-mono); font-weight:700; color:var(--accent-2); flex-shrink:0; }
.hyp-box .hyp-text{ text-align:justify; text-justify:inter-word; color:var(--ink); }
.test-stat-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:12px; }
.test-stat-row .stat-card{ flex:1; min-width:110px; }
.test-verdict{ display:inline-flex; align-items:center; gap:8px; border-radius:100px; padding:6px 14px; font-size:13px; font-weight:700; font-family:var(--font-mono); margin-bottom:10px; }
.test-verdict.ok{ background:#E7F3EA; color:var(--good); }
.test-verdict.bad{ background:var(--bad-bg); color:var(--bad); }
.test-conclusion{ font-size:14px; color:var(--ink); text-align:justify; text-justify:inter-word; margin:0; }
.test-note{ font-size:12.5px; color:var(--ink-faint); margin-top:10px; text-align:justify; text-justify:inter-word; }
table.mini-table{ border-collapse:collapse; width:100%; font-family:var(--font-mono); font-size:12.5px; margin-bottom:12px; }
table.mini-table th, table.mini-table td{ border:1px solid var(--rule); padding:6px 8px; text-align:center; }
table.mini-table thead th{ background:var(--paper-2); font-weight:700; }
table.mini-table td.ok{ color:var(--good); font-weight:700; }
table.mini-table td.bad{ color:var(--bad); font-weight:700; }

.chart-wrap{ display:flex; flex-direction:column; align-items:center; gap:10px; }
.chart-wrap canvas{ max-width:100%; border:1px solid var(--rule); border-radius:var(--radius); background:#fff; }
.chart-note{ font-size:13px; color:var(--ink-soft); text-align:center; max-width:60ch; }

/* ---------- HOME DASHBOARD ---------- */
.home-cta-wrap{ max-width:760px; margin:0 auto; padding:4px 24px 8px; }
.method-cta{
  display:flex; align-items:center; gap:14px; width:100%;
  background:var(--accent); color:#fff; border:none; border-radius:var(--radius);
  padding:18px 20px; cursor:pointer; text-align:left;
  box-shadow:var(--shadow);
  transition:background .12s ease, transform .08s ease;
}
.method-cta:hover{ background:var(--accent-hi); }
.method-cta:active{ background:var(--accent-press); transform:scale(.99); }
.method-cta .cta-icon{
  width:46px; height:46px; border-radius:11px; background:rgba(255,255,255,0.14);
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.method-cta .cta-icon svg{ width:24px; height:24px; }
.method-cta .cta-text{ flex:1; min-width:0; }
.method-cta .cta-title{ font-weight:700; font-size:15.5px; }
.method-cta .cta-sub{ font-size:12.5px; color:rgba(255,255,255,0.78); margin-top:3px; }
.method-cta .cta-chevron{ font-family:var(--font-display); font-size:28px; color:rgba(255,255,255,0.75); flex-shrink:0; }

/* ---------- HUB BERANDA (4 menu utama) ---------- */
.hub-grid{
  max-width:760px; margin:0 auto; padding:6px 24px calc(50px + var(--navh) + var(--safe-b));
  display:grid; grid-template-columns:1fr 1fr; gap:14px;
}
.hub-card{
  display:flex; flex-direction:column; align-items:flex-start; gap:10px; text-align:left;
  border:1px solid var(--rule); border-radius:var(--radius); background:#fff;
  box-shadow:var(--shadow);
  padding:20px 16px 18px; cursor:pointer;
  min-height:150px;
  transition:transform .1s ease, background .12s ease;
}
.hub-card:active{ transform:scale(.97); background:var(--paper-2); }
.hub-card .hc-icon{
  width:42px; height:42px; border-radius:12px;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.hub-card .hc-icon svg{ width:22px; height:22px; }
.hub-card .hc-title{ font-family:var(--font-display); font-weight:700; font-size:16.5px; color:var(--ink); line-height:1.25; }
.hub-card .hc-desc{ font-size:12px; color:var(--ink-soft); line-height:1.45; text-align:justify; text-justify:inter-word; }
.hc-icon.tone-navy{ background:#E3ECF0; color:var(--accent); }
.hc-icon.tone-gold{ background:#F6E9D2; color:#8A5A16; }
.hc-icon.tone-green{ background:#DFEEE3; color:var(--good); }
.hc-icon.tone-plum{ background:#EBE1EE; color:#6B3B7C; }

/* ---------- HALAMAN PETUNJUK ---------- */
.petunjuk-list{ display:flex; flex-direction:column; gap:16px; }
.petunjuk-item{
  display:flex; gap:14px; align-items:flex-start;
  border:1px solid var(--rule); border-radius:var(--radius); background:#fff;
  box-shadow:var(--shadow); padding:18px 18px 20px;
}
.petunjuk-num{
  flex-shrink:0; width:32px; height:32px; border-radius:50%;
  background:var(--accent); color:#fff; font-family:var(--font-mono); font-weight:700; font-size:14px;
  display:flex; align-items:center; justify-content:center;
}
.petunjuk-item h3{ font-family:var(--font-display); font-size:16.5px; margin:0 0 5px; color:var(--ink); font-weight:600; }
.petunjuk-item p{ margin:0; font-size:14px; color:var(--ink-soft); line-height:1.55; text-align:justify; text-justify:inter-word; }

/* ---------- HALAMAN KUIS STATISTIKA ---------- */
.quiz-progress-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; gap:12px; }
.quiz-progress-bar{ flex:1; height:8px; border-radius:5px; background:var(--paper-2); overflow:hidden; }
.quiz-progress-fill{ height:100%; background:var(--accent-2); border-radius:5px; transition:width .25s ease; }
.quiz-progress-label{ font-family:var(--font-mono); font-size:12.5px; color:var(--ink-faint); white-space:nowrap; }
.quiz-question{ font-family:var(--font-display); font-size:19px; font-weight:600; line-height:1.4; margin:0 0 18px; color:var(--ink); text-align:justify; text-justify:inter-word; }
.quiz-options{ display:flex; flex-direction:column; gap:10px; }
.quiz-opt{
  display:flex; align-items:center; gap:12px; text-align:left;
  border:1.5px solid var(--rule); border-radius:var(--radius); background:#fff;
  padding:13px 14px; cursor:pointer; font-size:14.5px; color:var(--ink);
  transition:border-color .12s ease, background .12s ease;
}
.quiz-opt .qo-text{ flex:1; text-align:justify; text-justify:inter-word; }
.quiz-opt .qo-letter{
  flex-shrink:0; width:28px; height:28px; border-radius:50%;
  background:var(--paper-2); color:var(--ink-soft); font-family:var(--font-mono); font-weight:700; font-size:12.5px;
  display:flex; align-items:center; justify-content:center;
}
.quiz-opt:active{ background:var(--paper-2); }
.quiz-opt.selected{ border-color:var(--accent); background:var(--accent-soft); }
.quiz-opt.selected .qo-letter{ background:var(--accent); color:#fff; }
.quiz-opt.correct{ border-color:var(--good); background:#E7F3EA; }
.quiz-opt.correct .qo-letter{ background:var(--good); color:#fff; }
.quiz-opt.wrong{ border-color:var(--bad); background:var(--bad-bg); }
.quiz-opt.wrong .qo-letter{ background:var(--bad); color:#fff; }
.quiz-nav-row{ display:flex; gap:10px; margin-top:22px; }
.quiz-explain{
  margin-top:16px; background:var(--paper-2); border-radius:var(--radius);
  padding:12px 14px; font-size:13.5px; color:var(--ink-soft); line-height:1.55; display:none;
  text-align:justify; text-justify:inter-word;
}
.quiz-explain.show{ display:block; }
.quiz-explain strong{ color:var(--ink); }
.quiz-score-ring{ display:flex; flex-direction:column; align-items:center; gap:6px; padding:10px 0 22px; }
.quiz-score-num{ font-family:var(--font-display); font-size:52px; font-weight:700; color:var(--accent); line-height:1; }
.quiz-score-label{ font-size:13.5px; color:var(--ink-soft); }
.quiz-review-item{ border-bottom:1px solid var(--rule); padding:14px 2px; }
.quiz-review-item:last-child{ border-bottom:none; }
.quiz-review-item .qr-q{ font-weight:600; font-size:14.5px; margin-bottom:6px; color:var(--ink); text-align:justify; text-justify:inter-word; }
.quiz-review-item .qr-tag{ display:inline-block; font-family:var(--font-mono); font-size:11px; font-weight:700; padding:2px 8px; border-radius:100px; margin-bottom:6px; }
.quiz-review-item.benar .qr-tag{ background:#E7F3EA; color:var(--good); }
.quiz-review-item.salah .qr-tag{ background:var(--bad-bg); color:var(--bad); }
.quiz-review-item .qr-ans{ font-size:13px; color:var(--ink-soft); margin:2px 0; text-align:justify; text-justify:inter-word; }
.quiz-review-item .qr-explain{ font-size:13px; color:var(--ink-soft); margin-top:6px; line-height:1.5; text-align:justify; text-justify:inter-word; }

/* ---------- HALAMAN KALKULATOR ILMIAH ---------- */
.calc-card{ padding:20px 18px 22px; }
.calc-display{
  background:var(--accent); border-radius:var(--radius); padding:20px 18px 16px;
  text-align:right; margin-bottom:14px; overflow:hidden;
}
.calc-expr{ font-family:var(--font-mono); font-size:13px; color:rgba(255,255,255,.6); min-height:18px; word-break:break-all; }
.calc-main{ font-family:var(--font-mono); font-size:34px; font-weight:600; color:#fff; word-break:break-all; margin-top:4px; }
.calc-mode-row{ display:flex; align-items:center; gap:8px; margin-bottom:12px; }
.calc-mode-btn{
  font-family:var(--font-mono); font-size:12px; font-weight:700; letter-spacing:.03em;
  border:1px solid var(--rule-strong); background:#fff; color:var(--ink-soft);
  border-radius:100px; padding:5px 12px; cursor:pointer;
}
.calc-mode-btn.active{ background:var(--accent-soft); color:var(--accent); border-color:var(--accent); }
.calc-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:8px; }
.calc-btn{
  min-height:46px; border-radius:10px; border:1px solid var(--rule); background:var(--paper-2);
  color:var(--ink); font-family:var(--font-mono); font-size:14.5px; font-weight:600; cursor:pointer;
  transition:background .1s ease, transform .08s ease;
}
.calc-btn:active{ transform:scale(.94); background:var(--accent-soft); }
.calc-btn.op{ background:var(--accent-soft); color:var(--accent); }
.calc-btn.fn{ background:#fff; color:var(--ink-soft); font-size:12.5px; }
.calc-btn.eq{ background:var(--accent); color:#fff; border-color:var(--accent); grid-column:span 2; }
.calc-btn.clear{ background:var(--bad-bg); color:var(--bad); }
@media (max-width:560px){
  .calc-grid{ gap:6px; }
  .calc-btn{ min-height:42px; font-size:13px; }
  .calc-main{ font-size:28px; }
}

/* ---------- HALAMAN TENTANG ---------- */
.tentang-body{
  max-width:760px; margin:0 auto; padding:8px 24px calc(50px + var(--navh) + var(--safe-b));
  display:flex; flex-direction:column; gap:0;
}
.tentang-item{ border-bottom:1px solid var(--rule); padding:16px 2px; }
.tentang-item:first-child{ padding-top:2px; }
.tentang-item:last-child{ border-bottom:none; }
.tentang-item h3{ font-family:var(--font-display); font-size:16px; margin:0 0 6px; color:var(--ink); font-weight:600; }
.tentang-item p{ margin:0; font-size:14px; color:var(--ink-soft); }

/* ---------- BOTTOM NAVIGATION (menu utama aplikasi mobile) ---------- */
.bottom-nav{
  position:fixed; left:0; right:0; bottom:0; z-index:30;
  display:flex;
  background:#fff;
  border-top:1px solid var(--rule);
  padding:5px calc(4px + var(--safe-r)) calc(5px + var(--safe-b)) calc(4px + var(--safe-l));
  box-shadow:0 -2px 12px -6px rgba(28,30,36,0.22);
}
.nav-item{
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;
  background:none; border:none; cursor:pointer;
  padding:6px 4px; min-height:var(--tap);
  color:var(--ink-faint);
  font-family:var(--font-body); font-size:11px; font-weight:600;
  border-radius:var(--radius);
  transition:color .12s ease, background .12s ease;
}
.nav-item svg{ width:21px; height:21px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
.nav-item.active{ color:var(--accent); }
.nav-item:active{ background:var(--paper-2); }


/* ---------- MODE MOBILE / WEBVIEW ---------- */
@media (max-width:560px){
  .cover{ padding:calc(28px + var(--safe-t)) 18px 14px; }
  .cover h1{ font-size:clamp(30px,9vw,40px); }
  .toc-section{ padding:8px 16px 8px; }
  .cover-footer{ padding:0 16px calc(50px + var(--navh) + var(--safe-b)); }
  .chapter-inner{ padding:16px 16px calc(50px + var(--navh) + var(--safe-b)); gap:20px; }
  .card{ padding:18px 16px 22px; }
  .control-row{ gap:10px; }
  .control-row label{ width:100%; }
  .btn-primary, .btn-ghost{ flex:1 1 auto; width:100%; }
  .stepper{ flex-shrink:0; }
  .toc-row{ padding:16px 6px; }
  .toc-desc{ margin-left:0; margin-top:8px; }
  .toc-num{ width:34px; font-size:21px; }
  .toc-row-top{ gap:10px; }
  .toc-title{ font-size:15.5px; }
  .card h2{ font-size:20px; }
  .equation-box .eq{ font-size:18px; }
  .stat-grid{ grid-template-columns:repeat(2,1fr); }
  .table-scroll{ -webkit-overflow-scrolling:touch; }
  .home-cta-wrap{ padding:4px 16px 8px; }
  .hub-grid{ gap:10px; padding:6px 16px calc(50px + var(--navh) + var(--safe-b)); }
  .tentang-body{ padding:8px 16px calc(50px + var(--navh) + var(--safe-b)); }
  .nav-item span{ font-size:10.5px; }
}

/* Cegah pull-to-refresh/rubber-band pada WebView Android saat digulir di dalam kartu */
.table-scroll, .tabs{ overscroll-behavior-x:contain; }

/* =========================================================================
   3. LOGIN
   ========================================================================= */
#view-login{
  min-height:100vh; flex-direction:column; align-items:center; justify-content:center;
  padding:32px 24px calc(32px + var(--safe-b));
  background:
    radial-gradient(circle at 20% 15%, rgba(255,255,255,0.05), transparent 40%),
    linear-gradient(160deg, #16263380 0%, transparent 60%),
    var(--accent);
  position:relative; overflow:hidden;
}
/* FIX: display:flex dipindah ke sini agar tunduk pada aturan .view/.view.active
   (specificity ID selector sebelumnya membuat #view-login SELALU tampil,
   menimpa halaman lain walau class "active"-nya sudah dipindah oleh JS). */
#view-login.active{ display:flex; }
#view-login .login-sky{ position:absolute; inset:0; z-index:0; }
.login-box{
  position:relative; z-index:2;
  background:var(--paper); border-radius:18px;
  padding:34px 26px 28px; width:100%; max-width:380px;
  box-shadow:0 24px 60px -12px rgba(10,16,24,0.55);
  border:1px solid rgba(255,255,255,0.4);
}
.login-mark{ text-align:center; margin-bottom:22px; }
.login-mark .mark-badge{
  display:inline-flex; align-items:center; justify-content:center;
  width:58px; height:58px; border-radius:14px; margin-bottom:14px;
  background:var(--accent); color:#fff; font-family:var(--font-display); font-weight:700; font-size:24px;
}
.login-mark h1{ font-family:var(--font-display); font-weight:700; font-size:23px; color:var(--ink); margin:0 0 4px; }
.login-mark p{ font-size:13px; color:var(--ink-soft); margin:0; }
.login-field{ margin-bottom:14px; }
.login-field label{ display:block; font-family:var(--font-mono); font-size:11.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:6px; font-weight:600; }
.login-field input{
  width:100%; min-height:var(--tap); border:1.5px solid var(--rule); border-radius:10px;
  padding:12px 14px; font-family:var(--font-body); font-size:16px; color:var(--ink);
  background:#fff; outline:none; transition:border-color .15s ease, box-shadow .15s ease;
}
.login-field input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
.login-error{
  background:var(--bad-bg); color:var(--bad); border:1px solid #E0B8AC; border-radius:10px;
  padding:9px 13px; font-size:13px; font-weight:600; margin-bottom:14px; display:none; text-align:center;
}
.login-error.show{ display:block; }
.btn-login{
  width:100%; min-height:var(--tap); border:none; border-radius:10px;
  background:var(--accent); color:#fff; font-weight:700; font-size:15px; cursor:pointer;
  transition:background .12s ease, transform .08s ease; margin-top:2px;
}
.btn-login:hover{ background:var(--accent-hi); }
.btn-login:active{ background:var(--accent-press); transform:scale(.98); }
.login-foot{ text-align:center; margin-top:16px; font-size:11px; color:var(--ink-faint); }

/* =========================================================================
   4. HEADER LANGIT (ANIMASI SIANG/MALAM)
   ========================================================================= */
.sky-banner{
  position:relative; overflow:hidden; border-radius:0 0 20px 20px;
  padding:calc(14px + var(--safe-t)) 20px 34px;
  transition:background 3s ease;
}
.sky-banner-bg{ position:absolute; inset:0; z-index:0; transition:background 4s ease; }
.sky-star-canvas{ position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; }
.sky-clouds{ position:absolute; inset:0; z-index:2; pointer-events:none; transition:opacity 3s ease; }
.sky-extras{ position:absolute; inset:0; z-index:3; pointer-events:none; }
.sky-orbit{ position:absolute; width:260px; height:130px; bottom:0; left:50%; transform:translateX(-50%); z-index:3; pointer-events:none; overflow:visible; }
.sky-body{ position:absolute; width:34px; height:34px; display:flex; align-items:center; justify-content:center; font-size:26px; line-height:1; will-change:transform; }
@keyframes skyDrift{ 0%,100%{ transform:translateX(0); } 50%{ transform:translateX(14px); } }
@keyframes skyFloat{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-6px); } }

.sky-header-row{ position:relative; z-index:4; display:flex; align-items:center; justify-content:space-between; gap:12px; }
.sky-user{ display:flex; align-items:center; gap:12px; min-width:0; }
.sky-avatar{
  width:46px; height:46px; border-radius:50%; flex-shrink:0; cursor:pointer;
  background:rgba(255,255,255,0.16); border:2px solid rgba(255,255,255,0.55);
  display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-weight:700; font-size:18px; color:#fff;
}
.sky-greet{ min-width:0; }
.sky-greet .g-hi{ font-size:11.5px; color:rgba(255,255,255,0.78); font-weight:500; }
.sky-greet .g-name{ font-size:16px; color:#fff; font-weight:700; font-family:var(--font-display); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:44vw; }
.sky-clock{ font-family:var(--font-mono); font-size:11.5px; color:rgba(255,255,255,0.85); background:rgba(0,0,0,0.18); padding:5px 11px; border-radius:100px; flex-shrink:0; }

.eyebrow.on-sky{ border-color:rgba(255,255,255,0.6); color:#fff; }
.cover.on-sky{ position:relative; z-index:4; padding-top:18px; }
.cover.on-sky h1{ color:#fff; text-shadow:0 2px 12px rgba(0,0,0,0.25); }
.cover.on-sky .lede{ color:rgba(255,255,255,0.86); }

/* =========================================================================
   5. QUOTE CARD
   ========================================================================= */
.quote-card{
  position:relative; z-index:4; margin:16px 24px 0; max-width:712px; margin-left:auto; margin-right:auto;
  background:rgba(255,255,255,0.14); border:1px solid rgba(255,255,255,0.28); border-radius:var(--radius);
  padding:14px 18px; backdrop-filter:blur(2px);
}
.quote-card .q-text{ font-family:var(--font-display); font-style:italic; font-size:14.5px; color:#fff; line-height:1.5; margin:0 0 4px; }
.quote-card .q-author{ font-family:var(--font-mono); font-size:11.5px; color:rgba(255,255,255,0.75); }

/* =========================================================================
   6. PROFIL (SIDEBAR)
   ========================================================================= */
.profile-overlay{
  position:fixed; inset:0; background:rgba(20,22,26,0.42); z-index:60;
  opacity:0; pointer-events:none; transition:opacity .22s ease;
}
.profile-overlay.show{ opacity:1; pointer-events:auto; }
.profile-panel{
  position:fixed; top:0; right:0; bottom:0; width:min(340px, 88vw); z-index:61;
  background:var(--paper); box-shadow:-8px 0 30px -6px rgba(0,0,0,0.35);
  transform:translateX(100%); transition:transform .28s cubic-bezier(.2,.8,.2,1);
  display:flex; flex-direction:column;
}
.profile-panel.open{ transform:translateX(0); }
.profile-panel-head{
  background:var(--accent); color:#fff; padding:calc(20px + var(--safe-t)) 22px 22px;
  display:flex; align-items:center; gap:14px; position:relative;
}
.profile-panel-head .close-profile{
  position:absolute; top:calc(12px + var(--safe-t)); right:14px; background:rgba(255,255,255,0.14); border:none; color:#fff;
  width:32px; height:32px; border-radius:50%; font-size:18px; cursor:pointer; line-height:1;
}
.profile-avatar-big{
  width:56px; height:56px; border-radius:50%; background:rgba(255,255,255,0.18); border:2px solid rgba(255,255,255,0.5);
  display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; font-size:22px; flex-shrink:0;
}
.profile-panel-head .p-name{ font-family:var(--font-display); font-weight:700; font-size:17px; }
.profile-panel-head .p-sub{ font-size:12px; color:rgba(255,255,255,0.75); margin-top:2px; }
.profile-panel-body{ padding:16px; flex:1; overflow-y:auto; }
.profile-stat-row{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:18px; }
.profile-stat{ border:1px solid var(--rule); border-radius:var(--radius); padding:12px 14px; background:#fff; }
.profile-stat .p-k{ font-family:var(--font-mono); font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-faint); }
.profile-stat .p-v{ font-family:var(--font-mono); font-weight:700; font-size:17px; color:var(--accent); margin-top:3px; }
.profile-action{
  display:flex; align-items:center; gap:12px; width:100%; text-align:left; background:none; border:none;
  padding:13px 6px; border-bottom:1px solid var(--rule); cursor:pointer; color:var(--ink); font-size:14.5px; font-weight:600;
}
.profile-action:last-child{ border-bottom:none; }
.profile-action .pa-icon{ width:20px; height:20px; color:var(--ink-soft); flex-shrink:0; }
.profile-action.danger{ color:var(--bad); }
.profile-action.danger .pa-icon{ color:var(--bad); }
.profile-panel-foot{ padding:14px 16px calc(14px + var(--safe-b)); font-size:11px; color:var(--ink-faint); text-align:center; border-top:1px solid var(--rule); }

/* =========================================================================
   7. MENU KARTU (pengganti daftar bertitik untuk pilih metode & beranda)
   ========================================================================= */
.menu-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:760px; margin:0 auto; padding:4px 24px 8px; }
.menu-card{
  display:flex; flex-direction:column; gap:10px; text-align:left; width:100%;
  background:#fff; border:1px solid var(--rule); border-radius:var(--radius);
  padding:16px 15px; cursor:pointer; box-shadow:var(--shadow);
  transition:transform .1s ease, box-shadow .12s ease, border-color .12s ease;
}
.menu-card:active{ transform:scale(.97); }
.menu-card.is-soon{ cursor:default; opacity:.72; }
.menu-card .mc-top{ display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.menu-card .mc-icon{
  width:42px; height:42px; border-radius:11px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.menu-card .mc-icon svg{ width:22px; height:22px; }
